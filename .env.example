DEMO_MODE=False

# OpenAI 或兼容 OpenAI Chat Completions 的服务
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=90

# 高德开放平台 Web 服务 Key（供官方 MCP Server 鉴权）
AMAP_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp

# 高德 Web端（JS API）Key 与安全密钥，仅用于本地前端真实地图
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 可选：与参考项目一致，从 Unsplash 获取真实景点图片；留空时使用本地占位图
UNSPLASH_ACCESS_KEY=

HOST=127.0.0.1
PORT=8000
DEBUG=false
